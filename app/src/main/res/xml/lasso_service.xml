<?xml version="1.0" encoding="utf-8"?>
<!--
  Lasso doesn't read other apps' content: canRetrieveWindowContent is off.
  typeViewScrolled: wait for flings to stop before taking the screenshot.
  typeWindowStateChanged: which app is in front, to close the overlay when another app comes
    up, and to bring it back when Translate's popup closes.
  flagRequestAccessibilityButton: a floating button (or two-finger swipe up) that opens Lasso.
  flagRequestFilterKeyEvents: Back closes the overlay without the app below going back too.
  canTakeScreenshot: the screenshot that Lasso recognizes text in.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewScrolled|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents|flagRequestAccessibilityButton"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:canTakeScreenshot="true"
    android:description="@string/service_description"
    android:notificationTimeout="0"
    android:settingsActivity="dev.saeed.lasso.MainActivity" />
